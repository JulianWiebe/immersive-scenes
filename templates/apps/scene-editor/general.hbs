<section class="tab {{tab.cssClass}}" data-tab="general" data-group="primary">
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Name"}}</label>
    <div class="form-fields"><input type="text" name="name" value="{{scene.name}}" required></div>
  </div>
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Tags"}}</label>
    <div class="form-fields"><string-tags name="tags" value="{{scene.tags}}"></string-tags></div>
  </div>
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Folder"}}</label>
    <div class="form-fields"><select name="folder">{{selectOptions folderOptions selected=scene.folder}}</select></div>
  </div>
  <div class="form-group stacked">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Mode"}}</label>
    <div class="choice-cards">
      {{#each modeChoices}}
      <label class="choice-card {{#if checked}}checked{{/if}}">
        <input type="radio" name="mode" value="{{id}}" {{checked checked}}>
        <i class="{{icon}}" inert></i>
        <strong>{{label}}</strong>
        <span>{{hint}}</span>
      </label>
      {{/each}}
    </div>
  </div>
  {{#if isCastMode}}
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.CastStyle"}}</label>
    <div class="form-fields"><select name="castStyle">{{selectOptions castStyleOptions selected=scene.castStyle}}</select></div>
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Thumbnail"}}</label>
    <div class="form-fields"><file-picker name="thumb" type="imagevideo" value="{{scene.thumb}}"></file-picker></div>
    <p class="hint">{{localize "IMMERSIVE_SCENES.SceneEditor.ThumbHint"}}</p>
  </div>
  <div class="form-group stacked">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Notes"}}</label>
    <textarea name="notes" rows="5">{{scene.notes}}</textarea>
  </div>
</section>
