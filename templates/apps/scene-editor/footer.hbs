<footer class="form-footer">
  {{#if isPreview}}
  <button type="button" data-action="endPreview"><i class="fa-solid fa-eye-slash" inert></i> {{localize "IMMERSIVE_SCENES.Actions.EndPreview"}}</button>
  {{else}}
  <button type="button" data-action="preview"><i class="fa-solid fa-eye" inert></i> {{localize "IMMERSIVE_SCENES.Actions.PreviewOnCanvas"}}</button>
  {{/if}}
  {{#if canControl}}
  <button type="button" data-action="broadcast" class="{{#if isLive}}is-live{{/if}}">
    <i class="fa-solid fa-tower-broadcast" inert></i> {{#if isLive}}{{localize "IMMERSIVE_SCENES.Status.Live"}}{{else}}{{localize "IMMERSIVE_SCENES.Actions.Broadcast"}}{{/if}}
  </button>
  {{/if}}
</footer>
