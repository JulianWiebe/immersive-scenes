<section class="tab {{tab.cssClass}}" data-tab="layout" data-group="primary">
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Layout"}}</label>
    <div class="form-fields"><select name="layout.type">{{selectOptions layoutOptions selected=scene.layout.type}}</select></div>
    <p class="hint">{{localize (concat "IMMERSIVE_SCENES.LayoutHint." scene.layout.type)}}</p>
  </div>
  {{#unless freeform}}
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Anchor"}}</label>
    <div class="form-fields"><select name="layout.anchor">{{selectOptions anchorOptions selected=scene.layout.anchor}}</select></div>
  </div>
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Spacing"}}</label>
    <div class="form-fields"><range-picker name="layout.spacing" value="{{scene.layout.spacing}}" min="0.02" max="1" step="0.01"></range-picker></div>
  </div>
  {{#if (eq scene.layout.type "grid")}}
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Grid"}}</label>
    <div class="form-fields">
      <label class="inline">{{localize "IMMERSIVE_SCENES.Fields.Rows"}} <input type="number" name="layout.rows" value="{{scene.layout.rows}}" min="0" max="12" step="1"></label>
      <label class="inline">{{localize "IMMERSIVE_SCENES.Fields.Columns"}} <input type="number" name="layout.columns" value="{{scene.layout.columns}}" min="0" max="12" step="1"></label>
    </div>
    <p class="hint">{{localize "IMMERSIVE_SCENES.SceneEditor.GridHint"}}</p>
  </div>
  {{/if}}
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Margin"}}</label>
    <div class="form-fields"><range-picker name="layout.margin" value="{{scene.layout.margin}}" min="0" max="0.4" step="0.01"></range-picker></div>
  </div>
  {{/unless}}
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.HeroSize"}}</label>
    <div class="form-fields"><range-picker name="layout.heroSize" value="{{scene.layout.heroSize}}" min="0.1" max="2" step="0.01"></range-picker></div>
  </div>
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.TokenSize"}}</label>
    <div class="form-fields"><range-picker name="layout.tokenSize" value="{{scene.layout.tokenSize}}" min="0.05" max="1" step="0.01"></range-picker></div>
  </div>
  {{#if (eq scene.layout.type "theater")}}
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Depth"}}</label>
    <div class="form-fields"><range-picker name="layout.depth" value="{{scene.layout.depth}}" min="0" max="0.95" step="0.01"></range-picker></div>
    <p class="hint">{{localize "IMMERSIVE_SCENES.SceneEditor.DepthHint"}}</p>
  </div>
  {{/if}}
  {{#unless freeform}}
  <button type="button" data-action="freezeLayout"><i class="fa-solid fa-hand" inert></i> {{localize "IMMERSIVE_SCENES.SceneEditor.FreezeLayout"}}</button>
  {{/unless}}
</section>
