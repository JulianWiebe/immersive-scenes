<section class="tab {{tab.cssClass}}" data-tab="backgrounds" data-group="primary">
  <p class="hint">{{localize "IMMERSIVE_SCENES.SceneEditor.BackgroundsHint"}}</p>
  <ol class="row-list backgrounds">
    {{#each backgrounds}}
    <li class="row-item {{#if active}}active{{/if}}" data-index="{{index}}">
      <input type="hidden" name="backgrounds.{{index}}.id" value="{{id}}">
      <div class="row-thumb">
        {{#if isVideo}}<video src="{{src}}" muted loop autoplay playsinline></video>
        {{else if src}}<img src="{{src}}" alt="">{{else}}<i class="fa-solid fa-image" inert></i>{{/if}}
        <span class="step-number">{{number}}</span>
      </div>
      <div class="row-fields">
        <div class="field-line">
          <input type="text" name="backgrounds.{{index}}.name" value="{{name}}" placeholder="{{localize "IMMERSIVE_SCENES.Fields.Name"}}">
          <select name="backgrounds.{{index}}.fit" data-tooltip="{{localize "IMMERSIVE_SCENES.Fields.Fit"}}">{{selectOptions @root.fitOptions selected=fit}}</select>
        </div>
        <file-picker name="backgrounds.{{index}}.src" type="imagevideo" value="{{src}}"></file-picker>
        <div class="field-line">
          <label class="inline">{{localize "IMMERSIVE_SCENES.Fields.Color"}} <color-picker name="backgrounds.{{index}}.color" value="{{color}}"></color-picker></label>
          {{#if isVideo}}
          <label class="inline checkbox"><input type="checkbox" name="backgrounds.{{index}}.loop" {{checked loop}}> {{localize "IMMERSIVE_SCENES.Fields.Loop"}}</label>
          <label class="inline">{{localize "IMMERSIVE_SCENES.Fields.Volume"}} <range-picker name="backgrounds.{{index}}.volume" value="{{volume}}" min="0" max="1" step="0.05"></range-picker></label>
          {{/if}}
        </div>
      </div>
      <div class="row-controls">
        <button type="button" class="icon fa-solid fa-play" data-action="showStep" data-tooltip aria-label="{{localize "IMMERSIVE_SCENES.SceneEditor.ShowStep"}}"></button>
        <button type="button" class="icon fa-solid fa-arrow-up" data-action="moveBackground" data-delta="-1" {{disabled first}}></button>
        <button type="button" class="icon fa-solid fa-arrow-down" data-action="moveBackground" data-delta="1" {{disabled last}}></button>
        <button type="button" class="icon fa-solid fa-trash" data-action="removeBackground" data-tooltip aria-label="{{localize "IMMERSIVE_SCENES.Actions.Delete"}}"></button>
      </div>
    </li>
    {{else}}
    <li class="empty hint">{{localize "IMMERSIVE_SCENES.SceneEditor.NoBackgrounds"}}</li>
    {{/each}}
  </ol>
  <button type="button" data-action="addBackground"><i class="fa-solid fa-plus" inert></i> {{localize "IMMERSIVE_SCENES.SceneEditor.AddBackground"}}</button>
</section>
