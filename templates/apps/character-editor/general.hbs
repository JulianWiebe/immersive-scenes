<section class="tab {{tab.cssClass}}" data-tab="general" data-group="primary">
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Name"}}</label>
    <div class="form-fields"><input type="text" name="name" value="{{character.name}}" required></div>
  </div>
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Tags"}}</label>
    <div class="form-fields"><string-tags name="tags" value="{{character.tags}}"></string-tags></div>
  </div>
  <div class="form-group">
    <label>{{localize "IMMERSIVE_SCENES.Fields.Folder"}}</label>
    <div class="form-fields"><select name="folder">{{selectOptions folderOptions selected=character.folder}}</select></div>
  </div>

  <fieldset class="actor-drop">
    <legend>{{localize "IMMERSIVE_SCENES.CharacterEditor.LinkedActor"}}</legend>
    {{#if actor}}
    <div class="linked-actor">
      <img src="{{actor.img}}" alt="">
      <span class="name">{{actor.name}}</span>
      <button type="button" class="icon fa-solid fa-id-card" data-action="openActor" data-tooltip aria-label="{{localize "IMMERSIVE_SCENES.CharacterEditor.OpenActor"}}"></button>
      <button type="button" class="icon fa-solid fa-link-slash" data-action="unlinkActor" data-tooltip aria-label="{{localize "IMMERSIVE_SCENES.CharacterEditor.Unlink"}}"></button>
    </div>
    {{else if actorMissing}}
    <p class="hint warning">{{localize "IMMERSIVE_SCENES.CharacterEditor.ActorMissing"}}
      <button type="button" data-action="unlinkActor">{{localize "IMMERSIVE_SCENES.CharacterEditor.Unlink"}}</button></p>
    {{else}}
    <p class="hint">{{localize "IMMERSIVE_SCENES.CharacterEditor.DropActor"}}</p>
    {{/if}}
  </fieldset>

  <fieldset>
    <legend>{{localize "IMMERSIVE_SCENES.CharacterEditor.Owners"}}</legend>
    <p class="hint">{{localize "IMMERSIVE_SCENES.CharacterEditor.OwnersHint"}}</p>
    <div class="owner-list">
      {{#each users}}
      <label class="checkbox"><input type="checkbox" name="owners.{{id}}" {{checked checked}}>
        <span class="user-dot" style="background: {{color}}"></span> {{name}}</label>
      {{else}}
      <p class="hint">{{localize "IMMERSIVE_SCENES.CharacterEditor.NoPlayers"}}</p>
      {{/each}}
    </div>
  </fieldset>
</section>
